{
  "name": "@reticulum/appliance-client",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "api:check": "cargo run --locked -p reticulum-lxmf-chat-service --bin export-api-bindings -- --check",
    "api:generate": "cargo run --locked -p reticulum-lxmf-chat-service --bin export-api-bindings",
    "android": "bun --bun expo start --android",
    "assets:check": "bun run scripts/check-generated.ts",
    "build:web": "bun run scripts/build-web.ts",
    "dependencies:check": "bun --bun expo install --check",
    "format": "bun run scripts/check-toolchain.ts && bun x biome check --write .",
    "format:check": "bun run scripts/check-toolchain.ts && bun x biome check .",
    "ios": "bun --bun expo start --ios",
    "lint": "bun run format:check",
    "prebuild": "bun run scripts/check-toolchain.ts && expo prebuild",
    "start": "bun --bun expo start",
    "test": "bun run scripts/check-toolchain.ts && bun test ./src",
    "toolchain:check": "bun run scripts/check-toolchain.ts",
    "typecheck": "bun run scripts/check-toolchain.ts && bun x tsc --noEmit",
    "verify": "bun run api:check && bun run dependencies:check && bun run format:check && bun run typecheck && bun run test && bun run assets:check",
    "web": "bun --bun expo start --web"
  },
  "dependencies": {
    "expo": "57.0.8",
    "expo-constants": "57.0.7",
    "expo-crypto": "57.0.1",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.8",
    "expo-splash-screen": "57.0.5",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.13",
    "@types/react": "19.2.4",
    "typescript": "6.0.3"
  }
}
