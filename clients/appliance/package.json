{
  "name": "@reticulum/appliance-client",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "api:check": "cargo run --locked -p reticulum-appliance-service --bin export-api-bindings -- --check",
    "api:generate": "cargo run --locked -p reticulum-appliance-service --bin export-api-bindings",
    "android": "bun run native:run:android",
    "assets:check": "bun run scripts/check-generated.ts",
    "build:web": "bun run scripts/build-web.ts",
    "dependencies:check": "bun --bun expo install --check",
    "format": "bun run scripts/check-toolchain.ts && bun x biome check --write .",
    "format:check": "bun run scripts/check-toolchain.ts && bun x biome check .",
    "ios": "bun run native:run:ios",
    "lint": "bun run format:check",
    "native:bindings": "bun run scripts/native-bindings.ts all",
    "native:bindings:android": "bun run scripts/native-bindings.ts android",
    "native:bindings:check": "bun run scripts/native-bindings.ts check",
    "native:bindings:ios": "bun run scripts/native-bindings.ts ios",
    "native:run:android": "bun run scripts/run-native.ts android",
    "native:run:ios": "bun run scripts/run-native.ts ios",
    "native:verify": "bun run native:bindings:check && cargo test --locked -p reticulum-appliance-native && cargo clippy --locked -p reticulum-appliance-native --all-targets -- -D warnings",
    "prebuild": "bun run scripts/prebuild.ts",
    "release:android": "bun run scripts/run-release.ts android",
    "release:ios": "bun run scripts/run-release.ts ios",
    "release:test": "bun test scripts/run-release.test.ts",
    "start": "bun --bun expo start",
    "test": "bun run scripts/check-toolchain.ts && bun test ./src",
    "toolchain:check": "bun run scripts/check-toolchain.ts",
    "typecheck": "bun run scripts/check-toolchain.ts && bun x tsc --noEmit",
    "verify": "bun run api:check && bun run dependencies:check && bun run format:check && bun run typecheck && bun run test && bun run release:test && bun run assets:check",
    "web": "bun --bun expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "11.3.6",
    "@reticulum/appliance-native": "workspace:*",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-crypto": "57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.2",
    "maplibre-gl": "5.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.13",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.4",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "xcode@3.0.1": "patches/xcode@3.0.1.patch"
  }
}
